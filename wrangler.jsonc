{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sermon-steward",
  "compatibility_date": "2026-05-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/pastors",
      "/pastors/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.js"
}
