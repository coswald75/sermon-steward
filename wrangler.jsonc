{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sermon-steward",
  "compatibility_date": "2026-05-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/pastors",
      "/pastors/*",
      "/SGchurch",
      "/SGchurch/*",
      "/sgchurch",
      "/sgchurch/*",
      "/church",
      "/church/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.js"
}
