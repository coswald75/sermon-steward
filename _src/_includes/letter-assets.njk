<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #fbf8f1;
    --bg-card: #ffffff;
    --ink: #1a1a1a;
    --ink-soft: #4a4a4a;
    --ink-faint: #828282;
    --rule: #e6e1d3;
    --accent: #c4452f;
    --accent-deep: #9a3624;
    --accent-soft: #f0d4cc;
    --sans: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
    --serif: "Source Serif 4", "Iowan Old Style", Georgia, serif;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    background: var(--bg); color: var(--ink);
    font-family: var(--sans); font-size: 17px; line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--accent-deep); }
  a:hover { color: var(--accent); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  img { max-width: 100%; }

  .site-header {
    background: rgba(251, 248, 241, 0.92);
    border-bottom: 1px solid var(--rule);
  }
  .site-header-inner {
    max-width: 72rem; margin: 0 auto; padding: 16px 28px;
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
  }
  .wordmark {
    font-weight: 800; font-size: 18px; letter-spacing: -0.02em;
    color: var(--ink); text-decoration: none; white-space: nowrap;
  }
  .wordmark .dot { color: var(--accent); }
  .nav {
    font-size: 14px; font-weight: 500;
    display: flex; flex-wrap: wrap; gap: 8px 20px;
    align-items: center; justify-content: flex-end;
  }
  .nav a { color: var(--ink-soft); text-decoration: none; }
  .nav a:hover { color: var(--ink); }
  .nav a[aria-current="page"] { color: var(--ink); font-weight: 600; }

  .sheet {
    max-width: 36rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4.5rem;
  }
  .door { margin: 0 0 2rem; }
  .door-box {
    background: var(--bg-card);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 8px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 12px 32px rgba(60, 40, 20, 0.06);
  }
  .door-box img {
    display: block; width: 100%; height: auto;
    border-radius: 6px; background: #e6dcc6;
  }

  .letter {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.65;
    color: var(--ink);
  }
  .letter h1 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.85rem, 3vw, 2.2rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 0.75em;
  }
  .letter h1.greeting {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 1em;
  }
  .letter p { margin: 0 0 1em; }
  .letter .paths {
    list-style: none;
    margin: 1.35em 0 1.6em;
    padding: 0;
  }
  .letter .paths li {
    margin: 0;
    padding: 0.55em 0;
    border-top: 1px solid var(--rule);
  }
  .letter .paths li:last-child { border-bottom: 1px solid var(--rule); }
  .letter .paths a {
    color: var(--accent-deep);
    text-decoration: underline;
    text-decoration-color: rgba(154, 54, 36, 0.35);
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
  .letter .paths a:hover { color: var(--accent); text-decoration-color: var(--accent); }
  .letter .signoff { margin-top: 1.6em; }
  .letter .signoff p { margin: 0; }
  .letter .signoff .name { margin-top: 0.15em; }

  .sermons { list-style: none; margin: 0.4em 0 1.2em; padding: 0; }
  .sermons li {
    padding: 0.7em 0;
    border-top: 1px solid var(--rule);
  }
  .sermons li:last-child { border-bottom: 1px solid var(--rule); }
  .sermons a {
    display: block;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .sermons a:hover { color: var(--accent-deep); }
  .sermons .meta {
    display: block;
    margin-top: 0.15em;
    font-family: var(--sans);
    font-size: 0.78em;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .archive-link { font-size: 1.05rem; }

  .steps { margin: 0 0 1.2em; padding: 0; list-style: none; }
  .steps li {
    display: grid;
    grid-template-columns: 1.6em 1fr;
    gap: 0.35em;
    padding: 0.7em 0;
    border-top: 1px solid var(--rule);
  }
  .steps li:last-child { border-bottom: 1px solid var(--rule); }
  .steps .n {
    font-family: var(--sans);
    font-size: 0.75em;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent);
    padding-top: 0.35em;
  }

  .player {
    margin-top: 0.4em;
    background: var(--bg-card);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 18px 18px 16px;
  }
  .player-kicker {
    font-family: var(--sans);
    font-size: 12px; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--accent); margin: 0 0 14px;
  }
  .player-row { display: flex; gap: 14px; align-items: center; }
  .play {
    flex: none; width: 52px; height: 52px; border-radius: 50%;
    border: 0; background: var(--accent); color: #fff;
    display: grid; place-items: center;
    opacity: 0.4; cursor: not-allowed;
  }
  .play-icon {
    width: 0; height: 0;
    border-style: solid;
    border-width: 7px 0 7px 12px;
    border-color: transparent transparent transparent #fff;
    margin-left: 3px;
  }
  .player-meta { flex: 1; min-width: 0; }
  .player-title {
    font-family: var(--sans);
    font-weight: 700; font-size: 1rem; letter-spacing: -0.02em; margin: 0;
  }
  .player-sub {
    margin: 2px 0 10px;
    font-family: var(--sans);
    font-size: 0.85rem; color: var(--ink-soft);
  }
  .scrub {
    height: 6px; border-radius: 999px; background: #f5f1e6;
    border: 1px solid var(--rule); overflow: hidden;
  }
  .scrub span { display: block; width: 0; height: 100%; background: var(--accent); }
  .times {
    display: flex; justify-content: space-between;
    margin-top: 6px;
    font-family: var(--sans);
    font-size: 12px; color: var(--ink-faint); font-variant-numeric: tabular-nums;
  }
  .transcript {
    margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--rule);
  }
  .transcript h2 {
    margin: 0 0 6px;
    font-family: var(--sans);
    font-size: 12px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint);
  }
  .transcript p {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.05rem;
    color: var(--ink-soft);
  }
  .player-note {
    margin: 12px 0 0;
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  footer { padding: 28px 28px 36px; border-top: 1px solid var(--rule); }
  .foot-inner {
    max-width: 72rem; margin: 0 auto;
    display: flex; justify-content: space-between; align-items: center;
    gap: 18px 28px; flex-wrap: wrap;
  }
  .foot-brand { font-weight: 800; font-size: 16px; }
  .foot-brand .dot { color: var(--accent); }
  .foot-imprint { font-size: 13px; color: var(--ink-faint); margin-top: 2px; }
  .foot-imprint a { color: var(--ink-soft); text-decoration: none; }
  .foot-imprint a:hover { color: var(--ink); }
  .foot-nav { font-size: 14px; display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .foot-nav a { color: var(--ink-soft); text-decoration: none; }
  .foot-nav a:hover { color: var(--ink); }

  @media (max-width: 640px) {
    .site-header-inner { align-items: flex-start; padding: 14px 18px; }
    .sheet { padding-left: 1.15rem; padding-right: 1.15rem; }
    .nav { gap: 6px 14px; }
  }
</style>
