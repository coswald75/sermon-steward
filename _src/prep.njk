  }
  a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  a:hover { color: var(--ink-soft); }
  .page { max-width: 36rem; margin: 0 auto; padding: 72px 24px 96px; }
  .name { font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 28px; }
