<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Study · Sermon Steward</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+Pro:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:          #fbf8f1;
    --bg-card:     #ffffff;
    --ink:         #1a1a1a;
    --ink-soft:    #4a4a4a;
    --ink-faint:   #828282;
    --rule:        #e6e1d3;
    --rule-strong: #d8d0bd;
    --accent:      #c4452f;
    --accent-deep: #9a3624;
    --accent-soft: #f0d4cc;
    --highlight:   #fef0c8;
    --gold:        #b8893a;
    --teal:        #2d5a4a;
    --plum:        #5a3a6b;
    --olive:       #6b7a45;
    --sans:        'Inter', system-ui, -apple-system, "Segoe UI", sans-serif;
    --serif:       'Source Serif Pro', 'Iowan Old Style', Georgia, serif;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0; background: var(--bg); color: var(--ink);
    font-family: var(--sans); font-size: 16px; line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh; display: flex; flex-direction: column;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { color: var(--accent-deep); }

  /* ───── Header ───── */
  .site-header {
    padding: 20px 28px;
    border-bottom: 1px solid var(--rule);
    display: flex; align-items: center; justify-content: space-between;
    background: var(--bg);
  }
  .wordmark {
    font-weight: 800; font-size: 18px; letter-spacing: -0.02em;
    color: var(--ink); text-decoration: none;
  }
  .wordmark .dot { color: var(--accent); }
  .wordmark .study {
    font-weight: 500; color: var(--ink-soft);
    margin-left: 8px; font-size: 15px; letter-spacing: 0;
  }
  .session-bar {
    font-size: 13px; color: var(--ink-faint);
    display: flex; gap: 12px; align-items: center;
  }
  .session-bar button {
    background: none; border: none; color: var(--accent);
    font: inherit; cursor: pointer; padding: 0;
  }
  .session-bar button:hover { color: var(--accent-deep); }

  /* ───── Main ───── */
  main {
    flex: 1; display: flex; flex-direction: column;
    max-width: 820px; width: 100%; margin: 0 auto;
    padding: 32px 28px 24px;
  }

  /* ───── Sign-in gate ───── */
  .signin-card { max-width: 480px; margin: 64px auto; text-align: center; }
  .signin-card h1 {
    font-family: var(--sans); font-weight: 800;
    font-size: clamp(2.4rem, 5vw, 3.2rem);
    line-height: 1.05; letter-spacing: -0.03em;
    margin: 0 0 8px;
  }
  .signin-card .tagline {
    font-family: var(--serif); font-style: italic;
    font-size: 19px; color: var(--ink-soft);
    margin: 0 0 36px;
  }
  .signin-card .blurb {
    font-size: 15px; color: var(--ink-soft);
    margin: 0 0 24px; line-height: 1.6;
  }
  .signin-form { display: flex; gap: 8px; }
  .signin-form input {
    flex: 1; padding: 12px 14px; font: inherit; font-size: 15px;
    border: 1px solid var(--rule-strong); border-radius: 6px;
    background: var(--bg-card); color: var(--ink);
  }
  .signin-form input:focus {
    outline: none; border-color: var(--accent);
  }
  .signin-form button {
    background: var(--accent); color: white;
    border: none; border-radius: 6px;
    padding: 12px 20px; font: inherit; font-weight: 600;
    font-size: 14px; cursor: pointer;
    transition: background .15s;
  }
  .signin-form button:hover { background: var(--accent-deep); }
  .signin-form button:disabled { background: var(--ink-faint); cursor: default; }
  .signin-msg { margin-top: 18px; font-size: 14px; color: var(--ink-soft); }
  .signin-msg.error { color: var(--accent-deep); }

  /* ───── Chat surface ───── */
  .empty-state { margin-top: 24px; }
  .empty-state h1 {
    font-family: var(--sans); font-weight: 800;
    font-size: clamp(2.4rem, 5vw, 3.2rem);
    line-height: 1.05; letter-spacing: -0.03em;
    margin: 0 0 8px;
  }
  .empty-state .tagline {
    font-family: var(--serif); font-style: italic;
    font-size: 19px; color: var(--ink-soft);
    margin: 0 0 24px;
  }
  .empty-state .blurb {
    font-size: 15px; color: var(--ink-soft);
    max-width: 600px; line-height: 1.6;
    margin: 0 0 28px;
  }
  .examples { display: flex; flex-direction: column; gap: 8px; }
  .chip {
    text-align: left; background: var(--bg-card);
    border: 1px solid var(--rule); color: var(--ink-soft);
    padding: 12px 16px; border-radius: 8px;
    font: inherit; font-size: 14px; cursor: pointer;
    transition: all .15s;
  }
  .chip:hover {
    border-color: var(--accent); color: var(--ink);
    background: white;
  }

  .messages { display: flex; flex-direction: column; gap: 28px; }
  .user-msg {
    font-weight: 500; color: var(--ink); font-size: 16px;
    padding: 4px 0;
  }
  .user-msg::before {
    content: "› "; color: var(--accent); font-weight: 700;
  }
  .assistant-msg .route-bar {
    display: flex; gap: 10px; align-items: center;
    margin-bottom: 12px; font-size: 12px;
  }
  .route-chip {
    background: var(--accent); color: white;
    padding: 3px 9px; border-radius: 3px;
    font-weight: 600; letter-spacing: 0.5px;
    text-transform: uppercase; font-size: 10.5px;
  }
  .route-scope { color: var(--ink-faint); }
  .prose {
    font-size: 15.5px; line-height: 1.7; color: var(--ink);
    white-space: pre-wrap; min-height: 1em;
  }
  .prose.streaming::after {
    content: "▋"; color: var(--accent);
    animation: blink 1s steps(1) infinite;
    margin-left: 2px;
  }
  @keyframes blink { 0%,49%{opacity:1} 50%,100%{opacity:0} }

  .cards { margin-top: 18px; display: flex; flex-direction: column; gap: 10px; }
  .card {
    background: var(--bg-card); border: 1px solid var(--rule);
    border-left: 3px solid var(--ink-faint);
    border-radius: 6px; padding: 13px 16px;
  }
  .card[data-type="illustration"]      { border-left-color: var(--gold); }
  .card[data-type="application"]       { border-left-color: var(--teal); }
  .card[data-type="theological_claim"] { border-left-color: var(--plum); }
  .card[data-type="exposition"]        { border-left-color: var(--olive); }
  .card-meta {
    display: flex; gap: 10px; flex-wrap: wrap; align-items: center;
    margin-bottom: 8px; font-size: 12px;
  }
  .card-meta .title { color: var(--ink); font-weight: 600; }
  .card-meta .date, .card-meta .anchor { color: var(--ink-faint); }
  .card-meta .type {
    margin-left: auto; color: var(--ink-soft);
    font-variant: small-caps; letter-spacing: 0.5px;
  }
  .card-meta .loci { color: var(--ink-faint); font-style: italic; }
  .card-body {
    font-family: var(--serif); font-size: 15px;
    line-height: 1.6; color: var(--ink-soft);
  }

  /* ───── Composer ───── */
  .composer {
    border-top: 1px solid var(--rule); padding: 16px 28px;
    background: var(--bg);
  }
  .composer-inner {
    max-width: 820px; margin: 0 auto;
    display: flex; gap: 10px; align-items: flex-end;
  }
  .composer textarea {
    flex: 1; resize: none; background: var(--bg-card);
    border: 1px solid var(--rule-strong); border-radius: 8px;
    color: var(--ink); padding: 11px 14px; font: inherit;
    font-size: 15px; line-height: 1.5; min-height: 44px;
    max-height: 160px;
  }
  .composer textarea:focus {
    outline: none; border-color: var(--accent);
  }
  .composer button {
    background: var(--accent); color: white; border: none;
    border-radius: 8px; padding: 11px 22px;
    font: inherit; font-weight: 600; font-size: 14px;
    cursor: pointer; transition: background .15s;
  }
  .composer button:hover { background: var(--accent-deep); }
  .composer button:disabled { background: var(--ink-faint); cursor: default; }
  .footer-note {
    max-width: 820px; margin: 8px auto 0;
    font-size: 11.5px; color: var(--ink-faint);
  }

  .hidden { display: none !important; }
</style>
</head>
<body>

<header class="site-header">
  <div>
    <a class="wordmark" href="/">Sermon<span class="dot">.</span>Steward</a>
    <span class="study">The Study</span>
  </div>
  <div class="session-bar hidden" id="session-bar">
    <span id="session-email"></span>
    <button id="signout-btn">Sign out</button>
  </div>
</header>

<main>
  <!-- ───── Sign-in gate ───── -->
  <section class="signin-card" id="signin-section">
    <h1>The Study</h1>
    <p class="tagline">Ask your own preaching.</p>
    <p class="blurb">Sign in with the email associated with your account. We'll send a one-time link.</p>
    <form class="signin-form" id="signin-form">
      <input type="email" id="email-input" placeholder="you@example.com" required autocomplete="email">
      <button type="submit" id="signin-btn">Send link</button>
    </form>
    <div class="signin-msg" id="signin-msg"></div>
  </section>

  <!-- ───── Chat surface ───── -->
  <section class="hidden" id="chat-section">
    <div class="empty-state" id="empty-state">
      <h1>The Study</h1>
      <p class="tagline">Ask your own preaching.</p>
      <p class="blurb">
        One box. Recall, prep, or open question — the tool reads the shape of your query and scopes the search.
        Every answer shows the units it pulled, so you can see it's your words, not a guess.
      </p>
      <div class="examples">
        <button class="chip" data-q="Have I used the cemetery-plots illustration before?">Have I used the cemetery-plots illustration before?</button>
        <button class="chip" data-q="What have I said about Ephesians 4 and growth?">What have I said about Ephesians 4 and growth?</button>
        <button class="chip" data-q="Pull what I have on Christ-centered ministry for an upcoming sermon">Pull what I have on Christ-centered ministry for an upcoming sermon</button>
      </div>
    </div>
    <div class="messages" id="messages"></div>
  </section>
</main>

<footer class="composer hidden" id="composer">
  <div class="composer-inner">
    <textarea id="query-input" placeholder="Ask your corpus…" rows="1"></textarea>
    <button id="ask-btn">Ask</button>
  </div>
  <div class="footer-note">Every answer is grounded in cited units from your own sermons. The Study won't invent material.</div>
</footer>

<script type="module">
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.45.0';

  // ───── Config ─────
  const SUPABASE_URL = 'https://twbunmbzyqcqzgffdrib.supabase.co';
  const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR3YnVubWJ6eXFjcXpnZmZkcmliIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzE1ODgxODUsImV4cCI6MjA4NzE2NDE4NX0.8Y6tMnX5bhIWxTS7llFZElPY-st7rji0MtlTzxeqiW8';
  const FN_URL = SUPABASE_URL + '/functions/v1/corpus-query';

  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
    auth: { detectSessionInUrl: true, persistSession: true, autoRefreshToken: true }
  });

  // ───── DOM ─────
  const $ = (id) => document.getElementById(id);
  const signinSection = $('signin-section');
  const chatSection   = $('chat-section');
  const composer      = $('composer');
  const sessionBar    = $('session-bar');
  const sessionEmail  = $('session-email');
  const signoutBtn    = $('signout-btn');
  const signinForm    = $('signin-form');
  const emailInput    = $('email-input');
  const signinBtn     = $('signin-btn');
  const signinMsg     = $('signin-msg');
  const messages      = $('messages');
  const emptyState    = $('empty-state');
  const queryInput    = $('query-input');
  const askBtn        = $('ask-btn');

  // ───── Auth state ─────
  async function refreshAuthState() {
    const { data: { session } } = await supabase.auth.getSession();
    if (session?.user) {
      signinSection.classList.add('hidden');
      chatSection.classList.remove('hidden');
      composer.classList.remove('hidden');
      sessionBar.classList.remove('hidden');
      sessionEmail.textContent = session.user.email || '';
    } else {
      signinSection.classList.remove('hidden');
      chatSection.classList.add('hidden');
      composer.classList.add('hidden');
      sessionBar.classList.add('hidden');
    }
  }
  supabase.auth.onAuthStateChange(() => refreshAuthState());

  signinForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();
    if (!email) return;
    signinBtn.disabled = true;
    signinMsg.classList.remove('error');
    signinMsg.textContent = 'Sending…';

    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: {
        emailRedirectTo: window.location.origin + '/study',
        shouldCreateUser: false,
      },
    });

    signinBtn.disabled = false;
    if (error) {
      signinMsg.classList.add('error');
      signinMsg.textContent = error.message.includes('not')
        ? "That email isn't on the access list. Contact Chris if you should have access."
        : error.message;
      return;
    }
    signinMsg.textContent = 'Check your inbox. The link will sign you in and bring you back here.';
  });

  signoutBtn.addEventListener('click', async () => {
    await supabase.auth.signOut();
    messages.innerHTML = '';
    emptyState.classList.remove('hidden');
  });

  // ───── Composer ─────
  queryInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      askBtn.click();
    }
  });
  queryInput.addEventListener('input', () => {
    queryInput.style.height = 'auto';
    queryInput.style.height = Math.min(queryInput.scrollHeight, 160) + 'px';
  });
  document.querySelectorAll('.chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      queryInput.value = btn.dataset.q;
      askBtn.click();
    });
  });
  askBtn.addEventListener('click', () => ask());

  // ───── Card colors ─────
  const TYPE_LABELS = {
    illustration: 'illustration', application: 'application',
    theological_claim: 'theological claim', exposition: 'exposition',
    introduction: 'introduction', conclusion: 'conclusion',
    transition: 'transition', pastoral_aside: 'pastoral aside', prayer: 'prayer',
  };

  function renderUserMsg(text) {
    emptyState.classList.add('hidden');
    const el = document.createElement('div');
    el.className = 'user-msg';
    el.textContent = text;
    messages.appendChild(el);
    return el;
  }

  function renderAssistantMsg() {
    const wrap = document.createElement('div');
    wrap.className = 'assistant-msg';
    wrap.innerHTML = `
      <div class="route-bar">
        <span class="route-chip"></span>
        <span class="route-scope"></span>
      </div>
      <div class="prose streaming"></div>
      <div class="cards"></div>
    `;
    messages.appendChild(wrap);
    return wrap;
  }

  function renderCards(container, hits) {
    container.innerHTML = '';
    if (!hits || hits.length === 0) return;
    for (const h of hits) {
      const card = document.createElement('div');
      card.className = 'card';
      card.dataset.type = h.rhetorical_function || '';
      const subtype = h.illustration_type ? ' · ' + h.illustration_type.replace('_', ' ') : '';
      const typeLabel = (TYPE_LABELS[h.rhetorical_function] || h.rhetorical_function || '') + subtype;
      const loci = (h.doctrinal_loci || []).join(' · ');
      card.innerHTML = `
        <div class="card-meta">
          <span class="title"></span>
          <span class="date"></span>
          <span class="anchor"></span>
          <span class="loci"></span>
          <span class="type"></span>
        </div>
        <div class="card-body"></div>
      `;
      card.querySelector('.title').textContent  = h.sermon_title || '';
      card.querySelector('.date').textContent   = h.sermon_date  || '';
      card.querySelector('.anchor').textContent = '§' + (h.unit_index ?? '?');
      card.querySelector('.loci').textContent   = loci;
      card.querySelector('.type').textContent   = typeLabel;
      card.querySelector('.card-body').textContent = h.content || '';
      container.appendChild(card);
    }
  }

  // ───── Ask flow ─────
  async function ask() {
    const q = queryInput.value.trim();
    if (!q) return;
    askBtn.disabled = true;
    queryInput.value = '';
    queryInput.style.height = 'auto';

    renderUserMsg(q);
    const assistant = renderAssistantMsg();
    const chipEl    = assistant.querySelector('.route-chip');
    const scopeEl   = assistant.querySelector('.route-scope');
    const proseEl   = assistant.querySelector('.prose');
    const cardsEl   = assistant.querySelector('.cards');

    window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });

    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { throw new Error('Session expired — please sign in again.'); }

      const resp = await fetch(FN_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + session.access_token,
          'apikey': SUPABASE_ANON_KEY,
        },
        body: JSON.stringify({ query: q }),
      });

      if (!resp.ok) {
        const errBody = await resp.json().catch(() => ({ error: 'request failed' }));
        proseEl.classList.remove('streaming');
        proseEl.textContent = errBody.error || ('Error ' + resp.status);
        return;
      }

      // Streamed body: JSON header + "\n---PROSE---\n" + prose tokens
      const reader = resp.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';
      let headerParsed = false;
      const SENTINEL = '\n---PROSE---\n';

      // Special-case: non-streaming JSON (canonical-not-enabled response)
      const ctype = resp.headers.get('Content-Type') || '';
      if (ctype.includes('application/json')) {
        const data = await new Response(resp.body).json().catch(() => ({}));
        chipEl.textContent  = (data.route?.intent || 'info').toUpperCase();
        scopeEl.textContent = data.route?.scope ? data.route.scope + (data.hits ? ` · matched ${data.hits.length}` : '') : '';
        renderCards(cardsEl, data.hits || []);
        proseEl.classList.remove('streaming');
        proseEl.textContent = data.message || '';
        return;
      }

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });

        if (!headerParsed) {
          const idx = buffer.indexOf(SENTINEL);
          if (idx === -1) continue;
          const headerJSON = buffer.slice(0, idx);
          buffer = buffer.slice(idx + SENTINEL.length);
          try {
            const head = JSON.parse(headerJSON);
            chipEl.textContent  = (head.route?.intent || '').toUpperCase();
            const count = (head.hits || []).length;
            scopeEl.textContent = (head.route?.scope || '') + ' · matched ' + count + ' unit' + (count === 1 ? '' : 's');
            renderCards(cardsEl, head.hits || []);
          } catch (parseErr) {
            chipEl.textContent  = 'ERROR';
            scopeEl.textContent = 'Could not parse retrieval header';
          }
          headerParsed = true;
        }

        if (headerParsed && buffer.length) {
          proseEl.textContent += buffer;
          buffer = '';
          window.scrollTo({ top: document.body.scrollHeight });
        }
      }
      proseEl.classList.remove('streaming');
    } catch (err) {
      proseEl.classList.remove('streaming');
      proseEl.textContent = (err && err.message) ? err.message : 'Something went wrong.';
    } finally {
      askBtn.disabled = false;
      queryInput.focus();
    }
  }

  // ───── Init ─────
  refreshAuthState();
</script>

</body>
</html>
